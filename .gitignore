# Build output (any folder starting with build, so build/, build-wsl/, build_pico/ ...)
/build/
/build*/
/src/build/
/src/build*/
/examples/*/build/
/examples/*/build*/

# Object files, libraries, executables
*.o
*.obj
*.a
*.lib
*.so
*.dll
*.dylib
*.exe
*.out
*.elf
*.uf2
*.bin
*.map

# CMake leftovers outside a build folder
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json
CTestTestfile.cmake
Testing/

# Debug files
*.dSYM/
*.pdb
*.su

# Python
__pycache__/
*.pyc

# Editors
.vscode/
.idea/
*.swp
*~

# Local notes that must never be committed (machine-specific paths live here)
/local/
